<component>
	<styles>
		<style name="style_base" bg_color="0xFF8800" text_color="0x000000" width="content" height="content" />
	</styles>

	<view extends="lv_slider" bind_value="slider_value" flex_flow="row">
		<style name="style_base" />
		<style name="red" selector="knob" />
		<style name="blue" selector="knob|focused" />
		<bind_style name="green" subject="slider_value" ref_value="50" selector="knob|focused" />
		<lv_label text="Current value: " />
		<lv_label bind_text="slider_value" />
	</view>
</component>
